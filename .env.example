MAX_BOT_TOKEN=
WEBHOOK_SECRET=
PORT=3000
# Optional override, defaults to https://platform-api2.max.ru (see bot/src/max-api.ts)
# MAX_API_BASE_URL=
# Ссылка для кнопки «Открыть мини-приложение» в приветствии бота.
# Если пусто — приветствие уходит без кнопки.
# WEBAPP_URL=https://max.ru/your_bot?startapp=
# CORS для /api (можно списком через запятую). Без неё — как раньше, без CORS-заголовков.
# ALLOWED_ORIGIN=https://your-frontend.example.com
# true — требовать заголовок X-Max-Init-Data на /api (когда фронт начнёт его слать).
# Без флага запросы проходят как раньше.
# REQUIRE_INIT_DATA=false
# Адрес API, который фронт зашьёт в себя при сборке Docker.
# Пусто = фронт работает на демо-данных. Для живых данных укажите публичный адрес бота.
# VITE_API_URL=https://your-domain.com
